{
  "ReverseProxy": {
    "Routes": {
      "realtime-route": {
        "ClusterId": "realtime-cluster",
        "Match": {
          "Path": "/realtime/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/realtime"
          }
        ]
      },
      "matchmaking-route": {
        "ClusterId": "matchmaking-cluster",
        "Match": {
          "Path": "/matchmaking/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/matchmaking"
          }
        ]
      },
      "users-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/users/{**catch-all}"
        }
      },
      "sessions-route": {
        "ClusterId": "sessions-cluster",
        "Match": {
          "Path": "/sessions/{**catch-all}"
        }
      },
      "reports-route": {
        "ClusterId": "moderation-cluster",
        "Match": {
          "Path": "/reports/{**catch-all}"
        }
      },
      "moderation-route": {
        "ClusterId": "moderation-cluster",
        "Match": {
          "Path": "/moderation/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/moderation"
          }
        ]
      },
      "analytics-route": {
        "ClusterId": "analytics-cluster",
        "Match": {
          "Path": "/analytics/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "realtime-cluster": {
        "Destinations": {
          "realtime-destination": {
            "Address": "http://localhost:5005/"
          }
        }
      },
      "matchmaking-cluster": {
        "Destinations": {
          "matchmaking-destination": {
            "Address": "http://localhost:8081/"
          }
        }
      },
      "users-cluster": {
        "Destinations": {
          "users-destination": {
            "Address": "http://localhost:5010/"
          }
        }
      },
      "sessions-cluster": {
        "Destinations": {
          "sessions-destination": {
            "Address": "http://localhost:5011/"
          }
        }
      },
      "moderation-cluster": {
        "Destinations": {
          "moderation-destination": {
            "Address": "http://localhost:5012/"
          }
        }
      },
      "analytics-cluster": {
        "Destinations": {
          "analytics-destination": {
            "Address": "http://localhost:8083/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}