{
  "ReverseProxy": {
    "Routes": {
      "realtime-route": {
        "ClusterId": "realtime-cluster",
        "Match": {
          "Path": "/realtime/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/realtime"
          }
        ]
      },
      "matchmaking-route": {
        "ClusterId": "matchmaking-cluster",
        "Match": {
          "Path": "/matchmaking/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/matchmaking"
          }
        ]
      },
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/users/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/users"
          }
        ]
      },
      "session-route": {
        "ClusterId": "session-cluster",
        "Match": {
          "Path": "/sessions/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/sessions"
          }
        ]
      }
    },
    "Clusters": {
      "realtime-cluster": {
        "Destinations": {
          "realtime-destination": {
            "Address": "http://localhost:5005"
          }
        }
      },
      "matchmaking-cluster": {
        "Destinations": {
          "matchmaking-destination": {
            "Address": "http://localhost:8081"
          }
        }
      },
      "user-cluster": {
        "Destinations": {
          "user-destination": {
            "Address": "http://localhost:5010"
          }
        }
      },
      "session-cluster": {
        "Destinations": {
          "session-destination": {
            "Address": "http://localhost:5011"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}